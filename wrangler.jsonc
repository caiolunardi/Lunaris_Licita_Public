{
  "name": "lunaris-licita",
  "main": "./web/ui/worker/index.mjs",
  "compatibility_date": "2026-11-06",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./web/ui/dist/client",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/health"
    ],
    "not_found_handling": "single-page-application"
  }
}
